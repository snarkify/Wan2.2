# Demo-server environment template. Copy to .env.demo-server and fill in values.
# Real .env.* files are gitignored; this template stays in git so operators
# know what to set. Loaded by `set -a; source .env.demo-server; set +a` before
# `bash scripts/run_demo_server.sh`.

# --- required ---
WAN_DEMO_TOKEN=demo-secret
WAN_DEMO_CKPT_DIR=/path/to/Wan2.2-TI2V-5B
WAN_DEMO_OUTPUT_DIR=/path/to/demo_output

# --- optional ---
# WAN_DEMO_PORT=8000
# WAN_DEMO_HOST=0.0.0.0
# WAN_DEMO_MAX_QUEUE=3
# WAN_DEMO_PUBLIC_URL=http://gpu6:8000

# Set to 1 if your callback receivers live on localhost / RFC1918 / link-local
# (e.g. our own /v1/slack/callback at http://192.168.1.38:8000/...).
# WAN_DEMO_ALLOW_PRIVATE_CALLBACK=1

# 1-GPU + warm + fp8 is the default. Set GPUS=4 for the legacy FSDP+Ulysses
# fallback; set QUANT=bf16 to disable fp8 (slower but full-precision).
# WAN_DEMO_GPUS=1
# WAN_DEMO_QUANT=fp8

# --- Slack callback (only needed if any caller uses callback_url=…/v1/slack/callback) ---
# Bot token from the same Slack app the receiver bot uses (xoxb-…).
# WAN_SLACK_BOT_TOKEN=xoxb-...
# Comma-separated channel ID allow-list. Leave empty/unset to allow any
# channel that shows up in callback_metadata.
# WAN_SLACK_ALLOWED_CHANNELS=C070HJ0QP1U,C0ARZCSRXM0,C048K9W8X1V
